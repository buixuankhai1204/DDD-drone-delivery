# Copy to .env for local development (`cp .env.example .env`).
DATABASE_URL=postgres://shipping:shipping@localhost:5432/shipping
BIND_ADDR=127.0.0.1:8080
RUST_LOG=info,sqlx=warn

# Run without the Fleet and Flight Planning services (in-process stubs).
# Use `http` and set the two URLs below to call the real services.
EXTERNAL_SERVICES=stub
# FLEET_SERVICE_URL=http://localhost:8081
# FLIGHT_PLANNING_URL=http://localhost:8082
